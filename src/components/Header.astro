---
// components
import Indicator from './Indicator.astro';

import { execSync } from 'node:child_process';
import { getCollection } from 'astro:content';

// methods
// "Last updated" means the last time the tool list changed on main — i.e. a
// merged tool PR — not the scheduled status check. --first-parent makes a merge
// commit count with its own (merge) date instead of the branch commit's date.
function lastToolChange() {
  try {
    return execSync('git log -1 --first-parent --format=%cI -- src/content/tools', {
      encoding: 'utf-8',
    }).trim() || null;
  } catch {
    return null;
  }
}

// Without git history (e.g. a shallow clone), fall back to the newest addedAt.
const lastUpdated = lastToolChange() ?? (await getCollection('tools'))
  .map(tool => tool.data.addedAt.toISOString())
  .sort()
  .at(-1);

const formatted = lastUpdated
  // The build runs on a UTC runner, so pin the zone instead of inheriting it.
  ? new Date(lastUpdated).toLocaleDateString('de-DE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Berlin',
    })
  : '—';
---

<header class="header">
    <a href="/" class="header__logo">
        <h1 class="has-text-wrap has-max-width-6">
            <div class="flow-row has-gap-0">
                HSB
                <span class="has-color-neutral-400">
                    U
                </span>
                I
                <span class="has-color-neutral-400">
                    LD
                </span>
            </div>
        </h1>
    </a>
    <div class="header__indicator">
        <Indicator />
        <p class="has-size-8 has-text-uppercase has-color-neutral-700 has-ml-xs">
            zuletzt aktualisiert {formatted}
        </p>
    </div>
</header>

<style>
@import "cleacss/media-queries";

    .header {
        display: flex;
        flex-direction: column-reverse;
        grid-column: 2/-2;
        padding-block: var(--space-m);

        .header__logo {
            margin-top: var(--space-s);

            @media(--m) {
                margin-top: 0;
            }

            h1 {
                font-size: var(--font-size-2);

                @media(--m) {
                    font-size: var(--font-size-3);
                }
            }

        }

        @media(--m) {
            flex-direction: row;
            justify-content: space-between;
        }

        .header__indicator {
            display: flex;
            align-items: center;
        }
    }
</style>
